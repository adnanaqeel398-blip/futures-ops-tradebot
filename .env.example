PORT=8787
NODE_ENV=production

MASTER_KEY=your_master_key_here
TOKEN_SECRET=your_token_secret_here

ALLOW_LIVE_ORDERS=true
REQUIRE_SIGNED_REQUESTS=true

ALLOWED_IPS=true

DEFAULT_EXCHANGE=binance
DEFAULT_MARKET=futures
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_LEVERAGE=30
DEFAULT_ORDER_TYPE=MARKET

BINANCE_ENABLED=true
BINANCE_BASE_SPOT=https://api.binance.com
BINANCE_BASE_FUTURES=https://fapi.binance.com

MAX_USDT_PER_TRADE=10
MIN_USDT_PER_TRADE=5
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=100
DEFAULT_STOP_LOSS_PCT=0.35
DEFAULT_TAKE_PROFIT_PCT=0.25
DEFAULT_TRAIL_PCT=0.20

REQUESTS_PER_MINUTE=120
ORDER_COOLDOWN_MS=8000

WEBHOOK_ENABLED=true
WEBHOOK_SECRET=your_webhook_secret_here

LOG_LEVEL=info
LOG_ORDERS=true
LOG_BALANCE=true
LOG_SIGNALS=true
